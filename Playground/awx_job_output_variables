# AWX_URL, AWX_TOKEN and TIMEOUT come from awx_invenotry_hosts_variables.
# None inherits the workbook/sheet/execution column from awx_execute_jobs_variables.
INPUT_FILE = None
SHEET_NAME = None
EXECUTION_COLUMN = None

# Add/update this Excel column with the job's complete stdout (within Excel limits).
OUTPUT_COLUMN = "output"

# Files: <job_id>.<inventory_name>.<ostype>.txt; relative to the working directory.
# Invalid Windows filename characters in inventory/OS names are replaced with '_'.
OUTPUT_DIRECTORY = "output"

# Wait for running jobs to finish before collecting their complete logs.
# False collects the output available now; rerun later to refresh it.
# Logs of failed/error/canceled jobs are collected as well.
WAIT_FOR_COMPLETION = True
POLL_INTERVAL = 5
JOB_WAIT_TIMEOUT = 3600
